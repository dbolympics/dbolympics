#!/bin/bash
# the query program
if [ -f query.pid ]; then
    kill "$(cat query.pid)" 2>/dev/null || true
    rm -f query.pid
fi

if [ -f server.pid ]; then
    pid=$(cat server.pid)
    kill "$pid" 2>/dev/null || true
    for _ in $(seq 1 120); do
        kill -0 "$pid" 2>/dev/null || break
        # A container PID 1 may leave an exited server as a zombie. It is already stopped.
        grep -q '^State:.*Z' "/proc/$pid/status" 2>/dev/null && break
        sleep 1
    done
    kill -9 "$pid" 2>/dev/null || true
fi
rm -f server.pid
exit 0
