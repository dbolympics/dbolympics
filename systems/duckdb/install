#!/bin/bash
# DuckDB is a library, embedded in the query program.
set -e

# DuckDB's library of the release, which the query program links (DUCKDB_LIB_DIR)
curl -fsSL --retry 10 -o /tmp/libduckdb.tar.gz "https://github.com/duckdb/duckdb/releases/download/v2.0.0/duckdb-shared-libs-linux-$(dpkg --print-architecture).tar.gz"
mkdir -p /tmp/libduckdb
tar -xzf /tmp/libduckdb.tar.gz -C /tmp/libduckdb
sudo install -m 0644 /tmp/libduckdb/libduckdb.so /usr/local/lib/
sudo install -m 0644 /tmp/libduckdb/duckdb.h /usr/local/include/
sudo ldconfig
rm -rf /tmp/libduckdb /tmp/libduckdb.tar.gz

# the query program (query.rs), built here with a Rust toolchain that is removed again
cd /system
sudo apt-get update -y
sudo apt-get install -y --no-install-recommends build-essential
curl -fsSL --retry 10 https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain 1.99.0
DUCKDB_LIB_DIR=/usr/local/lib DUCKDB_INCLUDE_DIR=/usr/local/include "$HOME/.cargo/bin/cargo" build --release --locked
install -m 0755 target/release/query query
rm -rf target "$HOME/.cargo" "$HOME/.rustup"
